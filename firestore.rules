rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dados só podem ser lidos por usuários autenticados e autorizados.
    // Escritas são feitas exclusivamente pelas Cloud Functions.
    function signedIn() { return request.auth != null; }
    function isAllowed() {
      return signedIn()
        && exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email));
    }
    match /allowlist/{email} {
      allow read: if signedIn() && request.auth.token.email == email;
      allow write: if false;
    }
    match /items/{itemId} {
      allow read: if isAllowed();
      allow write: if false;
    }
    match /reservations/{uid} {
      allow read: if isAllowed() && (request.auth.uid == uid);
      allow write: if false;
    }
    match /adminData/{docId} {
      allow read, write: if false;
    }
  }
}
